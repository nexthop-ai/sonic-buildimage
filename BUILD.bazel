# Drift guard (docker analog of pkg_deps_drift_test): every fine-grained docker's Bazel `release`
# (docker_image 2nd positional) must match its .mk `SONIC_<REL>_DOCKERS` membership. docker_base_drift
# only pins release via the base stem, so a BASE-LESS docker (docker-ptf, FROM debian:<rel> directly)
# was unchecked -- that gap let docker-ptf keep release="bookworm" after upstream #27889 flipped it to
# SONIC_TRIXIE_DOCKERS. Vendor/template dockers whose .mk stem is a make var are skipped (reported).
py_test(
    name = "docker_release_drift_test",
    srcs = ["nhbazel/tests/docker_release_drift_test.py"],
    # The .bzl glob is recursive to match the test's own `nhbazel/**/docker-*.bzl` discovery, so a
    # docker .bzl added at a novel depth is staged into the sandbox and actually checked (not
