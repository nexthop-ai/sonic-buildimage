# ONE platform-neutral configure target (:sonic_configure). It reads :platform_value and
# runs `make configure PLATFORM=<that>`, then writes the platform into the CONTENT of
# sonic_configure.ok, which every deb/wheel/docker/image rule depends on -- so the lane's
# transition (its platform) re-keys the whole graph. Configure ALL release envs (a
# package's slave tree must exist for whichever release it builds in).
sonic_configure(
    debian_releases = SUPPORTED_RELEASE_BUILDS,
)

# What make configure reads, for the frozen configure hotpatches/BUILD.bazel declares.
sonic_configure_sources(name = "configure_sources")

# Compat aliases for //nhbroadcomsai:build_sai.bzl, which still names the pre-refactor
# per-platform configure targets (:sonic_configure_vs for bcmsim, :sonic_configure_broadcom
# otherwise). Both now resolve to the single platform-neutral :sonic_configure -- the
# ACTUAL platform comes from the consuming lane's transition (a bcmsim SAI built under the
# :vs_bcm<chip> lane configures vs; a regular SAI under a broadcom lane configures broadcom),
# not from the alias name. Lets nhbroadcomsai stay unedited.
alias(
    name = "sonic_configure_vs",
    actual = ":sonic_configure",
    # Compat alias for the non-hermetic :sonic_configure genrule; without this
    # tag the alias stays in the ci lane's top-level set and re-pulls the whole
    # sonic_init -> slave_base_image -> configure chain (~33 min). Image lanes
    # still resolve it fine (they don't filter not-for-ci).
    tags = ["not-for-ci"],
    visibility = ["//visibility:public"],
)

alias(
    name = "sonic_configure_broadcom",
    actual = ":sonic_configure",
    # Compat alias for the non-hermetic :sonic_configure genrule; without this
    # tag the alias stays in the ci lane's top-level set and re-pulls the whole
    # sonic_init -> slave_base_image -> configure chain (~33 min). Image lanes
    # still resolve it fine (they don't filter not-for-ci).
    tags = ["not-for-ci"],
    visibility = ["//visibility:public"],
)

