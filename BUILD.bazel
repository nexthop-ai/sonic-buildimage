docker_p4rt()

# The Broadcom XGS/DNX SAI syncd containers (platform dockers; bookworm-pinned).
docker_syncd_brcm(images = _IMAGES)

docker_syncd_brcm_dnx(images = _IMAGES)

# Post-build docker sets -- declared AFTER every base they derive FROM (the app dockers
# above + docker-syncd-brcm{,-dnx}), because docker_image()'s transitive base-context
# closure resolves each base via native.existing_rule, which only sees rules defined
# earlier. base -> ... -> leaf must be in order, so these post-build leaves come last.
# :broadcom_debug_minimal -> orchagent + fpm-frr + syncd-brcm -dbg (PR lane subset),
# :broadcom_dbg_full       -> the full ship set of -dbg dockers (CI/ci-te/release lanes),
# :broadcom_syncd_rpc      -> syncd-brcm-rpc + syncd-brcm-dnx-rpc docker images.
# All are post-build steps that reuse the Bazel-staged debs instead of rebuilding the
# swss/SAI stack from source. broadcom_dbg_dockers defines every -dbg docker once and
# emits both the minimal and full aggregates.
#
# A dbg/rpc docker whose parent ACTIVE_DOCKERS gates off can't derive FROM a staged parent; it
# is instead built AFTER the platform's image make (which built the parent inline), in that
# make's reroute context. _POST_IMAGE is that context per platform: the image genrule per target
# variant (the ordering dep) + the image make's env/prebuilt flag (lib/post_image_docker.bzl).
_POST_IMAGE = {
    "broadcom": broadcom_post_image(),
    "vs": vs_post_image(),
}

broadcom_dbg_dockers(
    images = _IMAGES,
    post_image = _POST_IMAGE,
)

broadcom_rpc_dockers(
    images = _IMAGES,
    post_image = _POST_IMAGE,
)

# :vs_default -> the vs image (sonic-vs.img.gz); + :docker_ptf / :docker_sonic_vs (tagged).
# All platform=vs-compatible; the ci-pr / ci-te-candidate pattern builds add the dockers.
# vs_targets() also emits the VS-BCMSIM KVM images (`:vs_bcm<chip>`, one per
# platform/vs/sims.bzl VS_SIMS row) + their docker-syncd-bcmsim variants -- each is
# platform=vs target_compatible_with, and builder.py passes --//sonic-buildimage:platform=vs
# so the bcmsim SAI dep configures vs, not broadcom. _POST_IMAGE: docker-sonic-vs builds after
# the vs_default image when its base is gated off (see broadcom_dbg_dockers above).
vs_targets(post_image = _POST_IMAGE)
