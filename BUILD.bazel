# extracts them into target/debs/<release> so the broadcom make skips the
# ~30 min grub2 build. The broadcom genrules depend on the .ok sentinel.

# Aggregate barrier: build + stage the Bazel-managed debs/wheels, then emit one .ok that
# the platform image genrule depends on. sonic_broadcom_artifacts = broadcom (full set);
# sonic_generic_artifacts = generic (host-only trixie subset). All driven by the one
# membership table in nhbazel/lib/sonic-common-artifacts.bzl (D6).
broadcom_artifacts()

generic_artifacts()

# vs (shared closure minus the vendor-SAI syncd stack); consumed by both vs_default and vs_bcmsim
# so the vs image copies these debs instead of rebuilding them.
vs_artifacts()

# aspeed (curated arm64 trixie subset + sonic-redfish); consumed by the aspeed image so it copies
# these arm64 debs/wheels instead of rebuilding them from source.
aspeed_artifacts()

# Text manifest of every derived prebuilt token (all platforms); make_reroute_routing_test
# cross-checks rules/nh-bazel-prebuilt against it (the derived source of truth). The per-platform
# token sets come from each platform module -- the membership now lives there, not a central table.
derived_prebuilt_manifest(
    "derived_prebuilt_manifest",
    _ACTIVE_TOKENS,
)

# Build SONiC Broadcom images using locally built SAI from nhbroadcomsai.
# See broadcom.bzl for the genrule definition.
# :broadcom (alias -> :broadcom_default) -> sonic-broadcom.bin + sonic-broadcom-dnx.bin
# :broadcom_aboot -> sonic-aboot-broadcom.swi + sonic-aboot-broadcom-dnx.swi
# A debug image is not a separate target: it's :broadcom_default built with
# INSTALL_DEBUG_TOOLS=y (the debug flavor -- builder.py --debug / --config=debug, §7.4).
broadcom_image(target = "default")

broadcom_image(
    debug = True,
    target = "default",
)  # -> broadcom_default_debug

broadcom_image(target = "aboot")

# No _pr/_ci lane targets (design.md §7.4): the image build is `:broadcom_default` (dev) or
# the `//sonic-buildimage/...` pattern under --config=ci-pr / ci-te-candidate, which selects
# the image + the only-for-ci / only-for-nightly dbg/rpc dockers. The platform_broadcom
# config_setting + target_compatible_with scope the pattern to broadcom; --config carries the
# tag filter. builder.py drives it with --//sonic-buildimage:platform=broadcom.

# ============================================================================
# Generic platform (design.md §7.4): the minimal host-only ONIE image
# :generic_default -> sonic-generic.bin (no dockers, _INSTALLS=systemd-sonic-generator),
# plus :docker_sonic_mgmt, the one platform-unique docker. generic is PR-lane only.
# ============================================================================
generic_image()

generic_image(debug = True)  # -> generic_default_debug

# The per-platform image-docker label maps, assembled from the platform modules. Passed to
# every image docker_image() so it derives its own target_compatible_with (compat) -- membership
# lives in the platform modules, not a central fleet table.
# Active views (ACTIVE_DOCKERS-gated): a docker gated off drops out of compat + the is_extra
# gate here, so it becomes never-built and the native make builds it inline.
_IMAGES = {
    "broadcom": active_image(BROADCOM_IMAGE),
    "generic": active_image(GENERIC_IMAGE),
    "vs": active_image(VS_IMAGE),
    "aspeed": active_image(ASPEED_IMAGE),
}

docker_sonic_mgmt()

# ============================================================================
# Aspeed platform (design.md §7.4): the arm64 ONIE image
# :aspeed_default     -> sonic-aspeed-arm64.bin (one-image.mk SONIC_ONE_IMAGE). arm64 arch is
#                        threaded via :sonic_configure (PLATFORM_ARCH=arm64). First cut builds
#                        the arm64 closure from source in the arm64 slave (no amd64 prebuilt
#                        reuse); fine-grained arm64 debs/dockers are the task #27 follow-up.
# :aspeed_emmc        -> sonic-aspeed-arm64-emmc.img.gz (flashable AST2700 eMMC installer).
# :aspeed_default_all -> filegroup(:aspeed_default, :aspeed_emmc); the main-lane bundle
#                        builder.py builds so both artifacts land in one invocation (aspeed has
#                        no post-build phase).
# ============================================================================
aspeed_image()

aspeed_image(debug = True)  # -> aspeed_default_debug

aspeed_emmc_image()

# No generic lane target: `:generic_default` (host image) is the dev build; a
# `//sonic-buildimage/... --config=ci-pr --//sonic-buildimage:platform=generic` pattern adds
# :docker_sonic_mgmt (tagged only-for-ci). generic targets are platform_generic-compatible.

# :docker_base_trixie -> the SONiC base docker image (§7.5, root of the docker DAG).
