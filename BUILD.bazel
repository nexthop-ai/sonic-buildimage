# One label for the whole pre-build static gate -- every closure / dependency / docker /
# routing drift test: `bazel test //sonic-buildimage:closure_tests`. builder.py runs this before
# the (multi-hour) image build so any drift fails in seconds, not hours in.
test_suite(
    name = "closure_tests",
    tests = [
        ":active_deps_test",  # ACTIVE_PREBUILT dial is closure-closed (active dep of active pkg)
        ":dep_glob_drift_test",  # pkg source glob covers the trees its dpkg-cache .dep declares
        ":docker_base_drift_test",  # docker base == .mk _LOAD_DOCKERS
        ":docker_deps_drift_test",  # docker's .mk install deps captured in docker_image(deps)
        ":docker_gate_drift_test",  # IMAGE-list docker's config gate enabled in rules/config
        ":docker_release_drift_test",  # docker release == .mk SONIC_<REL>_DOCKERS membership
        ":host_root_closure_test",  # host root's build-only deps covered by its platform compat set
        ":host_root_install_drift_test",  # build_debian.sh host installs reconciled vs ASPEED_PACKAGES
        ":image_debug_parity_test",  # every <p>_<t>_debug image mirrors a base <p>_<t>
        ":image_docker_set_drift_test",  # IMAGE-list dockers are shipped by the platform's image
        ":image_matrix_test",  # the set of image targets matches the pinned canonical matrix
        ":make_cache_metadata_test",  # real Makefile.cache folds copy deb/wheel metadata into a dependent's key
        ":make_cache_precedence_test",  # dpkg cache precedence: converted pkg bypasses, else uses when on
        ":make_copy_content_test",  # copy deb/wheel .flags carry the staged file's content hash
        ":make_gate_routing_test",  # real make copy-vs-build routing under the gate block
        ":make_http_proxy_test",  # Makefile.http-proxy hands signal.env's proxy to a make without one
        ":make_reroute_routing_test",  # real reroute macros move a pristine pkg MAKE -> COPY on token
        ":pkg_deps_drift_test",  # pkg() deps == rules/<pkg>.mk deps
    ],
)

# Image-analyzability gate: every image target must ANALYZE under its own platform/target flags,
# so a silently-incompatible image (a gated/broken dep) is caught here instead of `:all` exiting 0
# with no .bin. NOT in the closure_tests suite -- an incompatible target in a suite/pattern is
# silently skipped, so this must be requested EXPLICITLY to error:
#   bazel test //sonic-buildimage:closure_tests //sonic-buildimage:image_analyze_test
image_analyze_tests(name = "image_analyze_test")

# The per-platform derived active-token map (host-roots closure UNION active-docker closures,
# per the ACTIVE_PREBUILT / ACTIVE_DOCKERS dials). Passed to every build_release_chain: each
# package gates its build genrule to the platforms whose manifest lists its reroute token
# (active_scope_of), so a package no active image consumes drops out of `//sonic-buildimage:all`
# and the image make builds it inline. Same map feeds derived_prebuilt_manifest below.
_ACTIVE_TOKENS = {
    "broadcom": broadcom_prebuilt_tokens(),
    "generic": generic_prebuilt_tokens(),
    "vs": vs_prebuilt_tokens(),
    "aspeed": aspeed_prebuilt_tokens(),
}

# The COMPAT set = the reroute manifest PLUS each platform's host-root stage_only co-producer
# build-deps (compat=True adds host_build_dep_tokens, e.g. sairedis via saithrift). This drives
# the per-platform gate (active_compat) -- NOT the reroute (_ACTIVE_TOKENS). A package builds on
# platform P iff its token is in P's COMPAT set, so a generic-only host package (swss) is
# incompatible on broadcom and does not build there, while a broadcom build-dep (sairedis) stays
# compatible on broadcom even though it is not a broadcom install/reroute token.
_COMPAT_TOKENS = {
    "broadcom": broadcom_prebuilt_tokens(compat = True),
    "generic": generic_prebuilt_tokens(compat = True),
    "vs": vs_prebuilt_tokens(compat = True),
    "aspeed": aspeed_prebuilt_tokens(compat = True),
}

