# Every package's sources, for a target that rebuilds a package it names only
# at build time: the patchlet macro in src/patchbrd/patchlet.bzl depends on
# this so an edit to a package's sources re-runs the patchlet. It is the glob
# every image make reads (_IMAGE_GLOB, nhbazel/lib/image.bzl:33), and it is that
# wide because a platform package's sources sit under platform/ while a
# daemon's sit under src/, and the manifest names the package at build time.
# SRC_GLOB_EXCLUDE keeps build output such as *.o and *.pyc out of it, so a
# build does not invalidate its own patchlet.
#
# glob stops at package boundaries, so a subdirectory carrying its own BUILD
# file is absent: src/patchbrd is one, and the patchlet macro names its files
# as explicit genrule deps for that reason.
filegroup(
    name = "package_sources",
    srcs = glob(
        [
            "device/**",
            "dockers/**",
            "files/**",
            "installer/**",
            "platform/**",
            "rules/**",
            "scripts/**",
            "src/**",
        ],
        exclude = SRC_GLOB_EXCLUDE,
    ),
    tags = ["not-for-ci"],
    visibility = ["//visibility:public"],
)

# Note: Versions are extracted from rules/*.mk files at build time (no hardcoded versions).

filegroup(
    name = "asic_init_files",
    srcs = [
        "platform/broadcom/sonic-platform-modules-nexthop/common/utils/fpga",
        "platform/broadcom/sonic-platform-modules-nexthop/nh-4010/utils/asic_init.sh",
    ] + glob([
        "platform/broadcom/sonic-platform-modules-nexthop/common/nexthop/**",
    ]),
    visibility = ["//fboss_extras/nexthop_product_support:__subpackages__"],
)

# ============================================================================
# Initialize all submodules
# ============================================================================
genrule(
    name = "sonic_init",
    srcs = [
        ".gitmodules",
        "Makefile",
        "Makefile.work",
    ],
    outs = ["sonic-init.ok"],
    cmd = log_setup("sonic-init.log") + """
        echo "=== Initializing SONiC ==="

        # Get the absolute path to the sonic-buildimage directory
        SONIC_DIR="$$(realpath sonic-buildimage)"
        echo "SONiC directory: $$SONIC_DIR"

        # Run init for build
        echo "Running init..."
        make -C "$$SONIC_DIR" fix-submodule-paths

        echo "=== SONiC Initialization Complete ==="

        # Dump git submodule status
        echo "=== Git Submodule Status ==="
        git -C "$$SONIC_DIR" submodule status

        # Produce a stable sentinel file for downstream deps
        echo "ok" > "$(location sonic-init.ok)"
    """,
    tags = [
        "local",
        "no-remote-cache",
        "no-sandbox",
        "not-for-ci",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Bazel cacheable slave base images
# ============================================================================
# sonic_configure_* restores these tarballs into the Docker
# daemon before running `make configure`. Builds are chained via
# serialize_after because the base builds share src/sonic-build-hooks
# scratch space.
[sonic_slave_base_image(
    debian_release = release,
    serialize_after = None if i == 0 else SUPPORTED_RELEASE_BUILDS[i - 1],
) for i, release in enumerate(SUPPORTED_RELEASE_BUILDS)]

# ============================================================================
# Configure SONiC and create tarballs for all required slave images
# This is the main entry point that:
# 1. Runs 'make configure' with appropriate NOxxx=1 flags
# 2. Builds Docker slave images
# 3. Creates tarballs for each slave image
# ============================================================================
# Platform selector (nhbazel/lib/platform_flag.bzl). //sonic-buildimage:platform is a
# string build setting (default broadcom), set on the command line
# (builder.py / `--//sonic-buildimage:platform=vs`). :platform_value writes the current
# value to a file genrules can read; the platform_<p> config_settings below let
# target_compatible_with (compatible_with_platform) scope a //sonic-buildimage/... pattern
# build to one platform.
platform_setting(
    name = "platform",
    build_setting_default = "broadcom",
    visibility = ["//visibility:public"],
)

# The "never-satisfied" constraint that compatible_with_platform / compatible_with_target use
# for their //conditions:default (incompatible) branch. This is a local equivalent of
# @platforms//:incompatible -- the root module doesn't declare a `platforms` bazel_dep, so
# @platforms isn't a visible repo, and referencing it errors the moment a target is analyzed
# as incompatible (e.g. a broadcom target under a generic :all build). No platform provides
# this constraint_value, so any target requiring it is incompatible everywhere.
constraint_setting(
    name = "sonic_incompatible_setting",
    visibility = ["//visibility:private"],
)

constraint_value(
    name = "incompatible",
    constraint_setting = ":sonic_incompatible_setting",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "platform_broadcom",
    flag_values = {":platform": "broadcom"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "platform_vs",
    flag_values = {":platform": "vs"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "platform_generic",
    flag_values = {":platform": "generic"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "platform_aspeed",
    flag_values = {":platform": "aspeed"},
    visibility = ["//visibility:public"],
)

platform_value(
    name = "platform_value",
    visibility = ["//visibility:public"],
)

# The SIM=BCM<chip> make-var for a bcm<chip> image variant (empty otherwise), read by the
# syncd deb build onto its make line so the bcmsim $(SYNCD) rule registers under a vs configure.
sim_value(
    name = "sim_value",
    visibility = ["//visibility:public"],
)

# 'ENABLE_SYNCD_RPC=y' for non-vs platforms (broadcom needs syncd-rpc), empty for vs (its bcmsim
# docker installs plain $(SYNCD)). Read onto the syncd make line so vs skips thrift/saithrift.
syncd_rpc_arg(
    name = "syncd_rpc_arg",
    visibility = ["//visibility:public"],
)

# Image VARIANT selector (//sonic-buildimage:target, default "default"). Orthogonal to
# platform: it selects which <platform>_<target> image genrule a `//sonic-buildimage:all`
# pattern resolves to (so :all builds ONE variant, not every SIM). The target_<t>
# config_settings below back compatible_with_target(); builder.py passes
# --//sonic-buildimage:target=<t> (default/aboot for broadcom; default/bcm78914/bcm78910 for
# vs). Does NOT affect :sonic_configure -- platform alone drives configure.
target_setting(
    name = "target",
    build_setting_default = "default",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_default",
    flag_values = {":target": "default"},
    visibility = ["//visibility:public"],
)

# platform=vs AND target=default: the plain software-SAI vs image. docker_image() uses this to
# suppress the broadcom vendor-SAI mount (NH_LOCAL_SAI_PATH_*) for vs_default, while keeping it
# for the vs bcm* SIM variants (and broadcom).
config_setting(
    name = "vs_target_default",
    flag_values = {
        ":platform": "vs",
        ":target": "default",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_aboot",
    flag_values = {":target": "aboot"},
    visibility = ["//visibility:public"],
)

# platform=broadcom AND target=<t>, one per broadcom image variant: the post-image dbg/rpc dockers
# (lib/post_image_docker.bzl) key their ordering dep (which image genrule) and compatibility on
# the exact variant, so `:all --//…:target=aboot` orders them after :broadcom_aboot. (vs has
# vs_target_default above.)
config_setting(
    name = "broadcom_target_default",
    flag_values = {
        ":platform": "broadcom",
        ":target": "default",
    },
