+  /*_________________---------------------------__________________
+    _________________   db_writeSflowPortStats  __________________
+    -----------------___________________________------------------
+  */
+
+  static void db_writeSflowPortStats(EVMod *mod) {
+    HSP *sp = (HSP *)EVROOTDATA(mod);
+    HSP_mod_SONIC *mdata = (HSP_mod_SONIC *)mod->data;
+    HSPSonicDBClient *db = db_selectClient(mod, HSP_SONIC_DB_STATE_NAME);
+    if(!db || !sp->agent) return;
+
+    for(SFLSampler *sm = sp->agent->samplers; sm; sm = sm->nxt) {
+      uint32_t osIndex = SFL_DS_INDEX(sm->dsi);
+      HSPSonicPort *prt = getPortByOsIndex(mod, osIndex);
+      if(!prt || !prt->portName) continue;
+
+      if(prt->sflowEnabled) {
+        redisAsyncCommand(db->ctx, db_writeStatsCB, NULL,
+          "HMSET SFLOW_STATS|%s"
+          " sample_pool %u"
+          " flow_samples %u"
+          " samples_this_tick %u"
+          " samples_last_tick %u",
+          prt->portName,
+          sm->samplePool,
+          sm->flowSampleSeqNo,
+          sm->samplesThisTick,
+          sm->samplesLastTick);
+        prt->statsWritten = YES;
+      }
+      else {
+        redisAsyncCommand(db->ctx, db_writeStatsCB, NULL,
+          "DEL SFLOW_STATS|%s", prt->portName);
+        prt->statsWritten = NO;
+      }
+    }
+  }
