    revision 2023-01-12 {
        description
            "First revision";
    }

    typedef report-type {
        description "Subscription reporting mode for dial-out telemetry.";
        type enumeration {
            enum periodic;
            enum stream;
            enum once;
        }
    }
    typedef path_target {
<<<<<<< HEAD
