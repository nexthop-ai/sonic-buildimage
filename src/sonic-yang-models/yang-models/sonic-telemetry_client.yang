        "TELEMETRY_CLIENT configuration";

    revision 2026-11-17 {
        description
            "Add OC_YANG to path_target. Require a report_interval of at least
             1000 for a stream Subscription to OTHERS, which is sampled at
             that interval.";
    }

    revision 2026-11-12 {
        description
            "Require a Subscription's dst_group to exactly name an existing
             DestinationGroup entry. Before this revision dst_group was only
             checked as a substring of the first TELEMETRY_CLIENT_LIST name, so
             a Subscription whose dst_group named no DestinationGroup validated
             before this revision and is now rejected.";
    }

    revision 2026-11-06 {
        description
            "Add vrf leaf to Global";
    }

    revision 2026-10-30 {
        description
            "Widen dst_addr from IPv4-only endpoints to host:port endpoints
             whose host may be a bracketed IPv6 address.";
    }
