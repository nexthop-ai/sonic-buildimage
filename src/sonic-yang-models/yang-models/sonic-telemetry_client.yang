module sonic-telemetry_client {

    yang-version 1.1;

    namespace "http://github.com/sonic-net/sonic-telemetry_client";
    prefix telemetry_client;

    import ietf-inet-types {
        prefix inet;
    }

    organization
        "SONiC";

    contact
        "SONiC";

    description
        "TELEMETRY_CLIENT yang Module for SONiC OS";

    revision 2026-10-30 {
        description
            "Widen dst_addr from IPv4-only endpoints to host:port endpoints
             whose host may be a bracketed IPv6 address.";
    }

    revision 2023-01-12 {
        description
            "First revision";
    }

    typedef report-type {
        description "Subscription reporting mode for dial-out telemetry.";
        type enumeration {
            enum periodic;
            enum stream;
            enum once;
        }
    }
    typedef path_target {
        description "SONiC database target for telemetry subscriptions.";
        type enumeration {
            enum APPL_DB;
            enum CONFIG_DB;
            enum COUNTERS_DB;
            enum STATE_DB;
            enum OTHERS;
        }
    }

    typedef encoding {
        description "Wire encoding format for telemetry data.";
        type enumeration {
            enum JSON_IETF;
            enum ASCII;
            enum BYTES;
            enum PROTO;
        }
    }

    typedef ip-port {
        description
            "One or more collector endpoints in host:port format, separated by
             commas. An IPv4 host is a dotted quad (10.0.0.1:8080). An IPv6
             host is any textual form inet:ipv6-address accepts -- full,
             compressed, IPv4-embedded or zone-scoped -- in square brackets
             ([fd00:1::1]:8080, [::ffff:10.0.0.1]:8080, [fe80::1%eth0]:8080).
             The two patterns mirror ietf-inet-types ipv6-address: the first
             bounds the characters and the group count of each host, the
             second its shape (eight groups, or exactly one '::').";
        type string {
            // host:port(,host:port)*
            pattern
                '((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}'
            +   '([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
            + '|\[((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}'
            +   '((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))'
            +   '|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}'
            +   '(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))'
            +   '(%[\p{N}\p{L}]+)?\]):'
            + '([0-9]|[1-9]\d{1,3}|[1-5]\d{1,4}|6[0-4]\d{1,3}|65[0-4]\d{1,2}|655[0-2][0-9]|6553[0-5])'
            + '(,((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}'
            +   '([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
            + '|\[((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}'
            +   '((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))'
            +   '|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}'
            +   '(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))'
            +   '(%[\p{N}\p{L}]+)?\]):'
            + '([0-9]|[1-9]\d{1,3}|[1-5]\d{1,4}|6[0-4]\d{1,3}|65[0-4]\d{1,2}|655[0-2][0-9]|6553[0-5]))*';
            // A bracketed host has eight colon-separated groups, or exactly
            // one '::' with no empty group elsewhere.
            pattern
                '([^:\[\],]+'
            + '|\[(([^:\[\],]+:){6}(([^:\[\],]+:[^:\[\],]+)|([^:\[\],]*\.[^:\[\],]*))'
            +   '|(([^:\[\],]+:)*[^:\[\],]+)?::(([^:\[\],]+:)*[^:\[\],]+)?)\]):[0-9]+'
            + '(,([^:\[\],]+'
            + '|\[(([^:\[\],]+:){6}(([^:\[\],]+:[^:\[\],]+)|([^:\[\],]*\.[^:\[\],]*))'
            +   '|(([^:\[\],]+:)*[^:\[\],]+)?::(([^:\[\],]+:)*[^:\[\],]+)?)\]):[0-9]+)*';
        }
    }

    container sonic-telemetry_client{

        container TELEMETRY_CLIENT {
            description "Telemetry dial-out client configuration.";
            container Global {
                description "Global settings for the telemetry dial-out client.";
                leaf retry_interval {
                    type uint64;
                    description "retry_interval unit s";
                }

                leaf src_ip {
                    type inet:ip-address;
                    description "Source IP address for dial-out connections.";
                }

                leaf encoding {
                    type encoding;
                    description "Data encoding format for telemetry messages.";
                }

                leaf unidirectional {
                    type boolean;
                    default true;
                    description "Whether the dial-out connection is unidirectional.";
                }
            }

            list TELEMETRY_CLIENT_LIST {
                description "Subscription and destination group entries for dial-out telemetry.";
                ordered-by user;
                key "prefix name";

                leaf prefix {
                    type string {
                        pattern 'Subscription|DestinationGroup';
                    }
                    description "Entry type: Subscription or DestinationGroup.";
                }

                leaf name {
                    type string;
                    description "Name of this subscription or destination group.";
                }

                leaf dst_addr {
                    type ip-port;
                    description
                        "Collector endpoints in host:port format, comma-separated;
                         an IPv6 host is bracketed ([fd00:1::1]:8080).";
                }

                leaf dst_group {
                    must "(contains(../../TELEMETRY_CLIENT_LIST/name, current()))";
                    type string;
                    description "Destination group name this subscription sends data to.";
                }

                leaf path_target {
                    type path_target;
                    description "Target database to subscribe to.";
                }

                leaf paths {
                    type string;
                    description "Comma-separated data paths to subscribe to within the target database.";
                }

                leaf report_interval {
                    type uint64;
                    description "report_interval unit ms";
                    default 5000;
                }

                leaf report_type {
                    type report-type;
                    description "Reporting mode for this subscription.";
                }
            }
        }
    }
}

