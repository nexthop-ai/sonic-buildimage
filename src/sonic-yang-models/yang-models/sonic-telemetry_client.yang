    typedef vrf-device {
        description "VRF the dial-out client makes its connections in.";
        type enumeration {
            enum default;
            enum mgmt;
        }
    }

    typedef ip-port {
        description
            "One or more collector endpoints in host:port format, separated by
             commas. An IPv4 host is a dotted quad (10.0.0.1:8080). An IPv6
             host is any textual form inet:ipv6-address accepts -- full,
             compressed, IPv4-embedded or zone-scoped -- in square brackets
             ([fd00:1::1]:8080, [::ffff:10.0.0.1]:8080, [fe80::1%eth0]:8080).
             The two patterns mirror ietf-inet-types ipv6-address: the first
             bounds the characters and the group count of each host, the
             second its shape (eight groups, or exactly one '::').";
