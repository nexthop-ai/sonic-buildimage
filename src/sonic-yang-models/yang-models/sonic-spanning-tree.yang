				// These four drive PVST only. MST takes its timers from STP_MST
				// and its priority from STP_MST_INST, so in MST mode they must
				// stay at their defaults.
				uses vlanModeAttr {
					refine forward_delay {
						default 15;
						must "../mode != 'mst' or current() = 15" {
							error-message "In MST mode the global forward_delay is not used; set forward_delay on the MST region instead";
						}
					}
					refine hello_time {
						default 2;
						must "../mode != 'mst' or current() = 2" {
							error-message "In MST mode the global hello_time is not used; set hello_time on the MST region instead";
						}
					}
					refine max_age {
						default 20;
						must "../mode != 'mst' or current() = 20" {
							error-message "In MST mode the global max_age is not used; set max_age on the MST region instead";
						}
						must "current() <= 2 * (../forward_delay - 1) and current() >= 2 * (../hello_time + 1)" {
							error-message "max_age must be between 2 x (hello_time + 1) and 2 x (forward_delay - 1)";
						}
					}
					refine priority {
						default 32768;
						must "../mode != 'mst' or current() = 32768" {
							error-message "In MST mode the global priority is not used; set bridge_priority on the MST instance instead";
						}
					}
				}
>>>>>>> afc4f42a7 (NOS-24027: [yang] apply the STP timer rule to the per-VLAN timers (#13653))
			}
		}

		container STP_VLAN {
			description
				"VLAN Specific STP Configurations, maps to STP_VLAN_TABLE";

			list STP_VLAN_LIST {
				key "name";
