module sonic-spanning-tree {
	yang-version 1.1;
	namespace "http://github.com/sonic-net/sonic-stp";
	
	prefix stp;

	/*
	import sonic-extension {
		prefix sonic-ext;
	}
	*/

	organization
		"SONiC";

	contact
		"SONiC";

	description
<<<<<<< HEAD
		"YANG model for Spanning Tree Protocol (STP) in SONiC, supporting PVST and MSTP";
=======
		"Spanning Tree Protocol (STP) configuration, supporting PVST and MSTP";

	revision 2026-11-19 {
		description
			"Apply 2 x (hello_time + 1) <= max_age <= 2 x (forward_delay - 1)
			 to the per-VLAN PVST timers. A timer or priority an STP_VLAN row
			 leaves out takes the global value, so those leaves carry no
			 default of their own.";
	}

	revision 2026-11-17 {
		description
			"STP_VLAN enabled defaults to true; STP_VLAN_PORT needs neither an
			 STP_PORT nor an STP_VLAN row, references VLAN, and is refused
			 outside PVST and on a PortChannel member.";
	}

	revision 2026-11-16 {
		description
			"Allow an MST region name of up to 32 characters, the full
			 802.1Q configuration name field.";
	}

	revision 2026-10-28 {
		description
			"Refuse configuration the daemons cannot use: an MST instance ID
			 outside 0..4094; MST instances while the mode is PVST, PVST VLAN
			 rows and uplink_fast while the mode is MST, and a non-default
			 global PVST timer, priority or rootguard_timeout while the mode
			 is MST; MST region values outside their 802.1Q ranges and a
			 region name longer than the 31 characters stpd keeps; timers
			 that break
			 2 x (hello_time + 1) <= max_age <= 2 x (forward_delay - 1);
			 malformed MST VLAN lists and a VLAN mapped to two instances; an
			 STP_VLAN name that is not Vlan<1-4094> or disagrees with vlanid;
			 STP on a PortChannel member; bpdu_guard_do_disable without
			 bpdu_guard.";
	}

	revision 2026-10-22 {
		description
			"Add the bridge_priority and port_priority typedefs: a bridge
			 priority is a multiple of 4096 from 0 to 61440 and a port priority
			 a multiple of 16 from 0 to 240, which the daemon rounds down to
			 anyway, so a value such as 4097, 100 or 17 is refused instead of
			 silently truncated.";
	}
>>>>>>> afc4f42a7 (NOS-24027: [yang] apply the STP timer rule to the per-VLAN timers (#13653))

	revision 2025-03-15 {
		description
			"Initial YANG model written for PVST & MSTP configurations xFlow & BRCM";
		reference
			"Initial implementation for SONiC STP support";
}

	grouping vlanModeAttr {
		description
			"PVST timers and bridge priority. The global row gives each a
			 default; a VLAN row that leaves one out takes the global value.";

		leaf forward_delay {
			type uint8 {
				range "4..30" {
					error-message "Invalid Forwarding Delay Value";
				}
			}
			units seconds;
			description
				"Delay before transitioning to the forwarding state";
		}

		leaf hello_time {
			type uint8 {
				range "1..10" {
					error-message "Invalid Hello Time value";
				}
			}
			units seconds;
			description
				"Interval between configuration BPDUs";
		}

		leaf max_age {
			type uint8 {
				range "6..40" {
					error-message "Invalid Maximum Age Time value";
				}
			}
			units seconds;
			description
				"Maximum time bridge stores BPDU information";
		}

		leaf priority {
<<<<<<< HEAD
			type uint16 {
				range "0..61440" {
					error-message "Invalid Bridge Priority value";
				}
			}
			default 32768;
=======
			type bridge_priority;
>>>>>>> afc4f42a7 (NOS-24027: [yang] apply the STP timer rule to the per-VLAN timers (#13653))
			description
				"Bridge Identifier priority component";
		}
	}

	grouping interfaceAttr {
		description
			"Configuration parameters for STP interfaces";

		leaf path_cost {
			type uint64 {
				range "1..200000000" {
					error-message "Invalid Port Path Cost value";
				}
			}
			default 200;
			description
				"Root path cost contribution";
		}

		leaf priority {
			type uint8 {
				range "0..240" {
					error-message "Invalid Port Priority value";
				}
			}
			default 128;
			description
				"Port priority in STP calculations";
		}
	}


	container sonic-spanning-tree {
		description
			"SONiC Spanning Tree Protocol (STP) configuration";

		container STP {
			description
				"Global STP configurations, maps to STP_GLOBAL_TABLE";

			list STP_LIST {
				key "keyleaf";
				max-elements 1;
				description
					"Global STP configuration settings";

				leaf keyleaf {
					type enumeration {
						enum GLOBAL {
							description
								"Global STP identifier";
						}
					}
					description
						"Key node identifier, always GLOBAL";
				}

				leaf mode {
					type enumeration {
						enum pvst {
							description
								"Per VLAN Spanning Tree Mode";
						}
						enum mst {
							description
								"Multiple Spanning Tree Mode";
						}
					}
					mandatory true;
					description
						"STP operating mode";
				}

				leaf rootguard_timeout {
					type uint16 {
						range "5..600" {
							error-message "Invalid Root-guard Timeout value";
						}
					}
					units "seconds";
					must "../mode = 'pvst'" {
						error-message "Root guard timeout configuration is allowed only in PVST mode";
						/*error-app-tag stp-invalid;*/
					}
					default 30;
					description
						"Once superior BPDUs stop coming on the port, device will wait for a period until root guard timeout before moving the port to forwarding state";
				}
<<<<<<< HEAD
				uses vlanModeAttr;
