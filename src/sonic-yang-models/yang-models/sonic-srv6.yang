module sonic-srv6 {
    namespace "http://github.com/sonic-net/sonic-srv6";
    prefix srv6;
    yang-version 1.1;

	import ietf-inet-types {
		prefix inet;
	}

    import sonic-vrf {
		prefix vrf;
	}

    import sonic-port {
        prefix prt;
    }

    import sonic-vlan {
        prefix vlan;
    }

    description
        "Segment Routing over IPv6 (SRv6) configuration for SONiC.";

    revision 2024-12-05 {
		description
			"Initial revision.";
	}

