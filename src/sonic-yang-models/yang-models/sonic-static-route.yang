module sonic-static-route {
  yang-version 1.1;
  namespace "http://github.com/sonic-net/sonic-static-route";
  prefix sroute;
  import ietf-inet-types {
    prefix inet;
  }
  organization
    "SONiC";
  contact
    "SONiC";
  description
<<<<<<< HEAD
    "STATIC ROUTE yang Module for SONiC OS";
=======
    "STATIC ROUTE configuration";

  revision 2026-08-14 {
    description
      "bfd and advertise are single route-level flags, not per-nexthop lists: one value
       applies to the whole route, and when bfd is enabled one session is created per
       nexthop. ifname entries are constrained to interface-name forms. The per-nexthop
       lists must agree in entry count, so the leaves that carry them no longer declare a
       scalar default -- a single default value cannot be correct for a list whose length
       must match the nexthop count. A route may not be configured under both key shapes.";
  }

  revision 2026-08-07 {
    description
      "Remodel sidlist out of static route list into its own composite-keyed list container,
       holding both STATIC_ROUTE_TEMPLATE_SIDLIST_LIST and STATIC_ROUTE_SIDLIST_LIST.
       The rearrangement is aftereffect of sonic environmental limitation which cannot
       validate nested list and configdb fails to disambiguates multiple lists sharing a
       container purely by key count.";
  }

  revision 2026-07-21 {
    description
      "Align STATIC_ROUTE_TEMPLATE_LIST with STATIC_ROUTE_LIST (distance, nexthop-vrf, blackhole, sidlist)
       and add the route tag attribute to both lists.";
  }

  revision 2026-03-19 {
    description
      "Add SR-Policy color attribute for nexthops";
  }

  revision 2026-02-25 {
    description
      "Add sidlist for SRv6 traffic steering.";
  }

  revision 2025-12-09 {
    description
      "Add BFD custom timer parameters: bfd_detect_multiplier, bfd_min_rx, bfd_min_tx";
  }
>>>>>>> e8ab45ae3 (NOS-14137: [sonic-yang-models] state the static-route contract in the model (#8012))

  revision 2022-03-17 {
    description
      "First Revision";
  }

  typedef static-route-flag {
    type string {
      pattern "(true|false)";
    }
    description
      "A route-level true/false flag. One value applies to the whole route.";
  }

  typedef static-route-ifname-list {
    type string {
      pattern "("
            + "Ethernet[0-9]+"
            + "|PortChannel[0-9]{1,4}"
            + "|Vlan(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[2-9])"
            + "|Loopback[0-9]+"
            + "|eth[0-9]+"
            + "|(Ethernet[0-9]+|PortChannel[0-9]{1,4})\\.([1-9][0-9]{0,2}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"
            + "|(Eth[0-9]+|Po[0-9]+)\\.([1-9][0-9]{0,2}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"
            + "|null"
            + ")?"
            + "(,("
            + "Ethernet[0-9]+"
            + "|PortChannel[0-9]{1,4}"
            + "|Vlan(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[2-9])"
            + "|Loopback[0-9]+"
            + "|eth[0-9]+"
            + "|(Ethernet[0-9]+|PortChannel[0-9]{1,4})\\.([1-9][0-9]{0,2}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"
            + "|(Eth[0-9]+|Po[0-9]+)\\.([1-9][0-9]{0,2}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"
            + "|null"
            + ")?)*";
    }
    description
      "Comma-separated egress interfaces, one entry per nexthop. An entry may be empty when
       its nexthop has no egress interface; 'null' selects the null interface. Internal port
       names are excluded: the alternatives above are the only accepted spellings, so any
       other name -- recycle ports among them -- is refused rather than enumerated.";
  }

  container sonic-static-route {
    container STATIC_ROUTE {
      description
        "Static route entries for deterministic IP forwarding.";
      list STATIC_ROUTE_TEMPLATE_LIST {
        key "prefix";
        must "not(bfd = 'true') or (ifname and ifname != '')" {
          error-message
            "bfd requires ifname: BFD monitoring creates one session per nexthop and the egress
             interface of each is what identifies it, so a route with bfd enabled and no ifname
             is handed to staticroutebfd, refused there, and programmed nowhere.";
        }
        must "not(ifname) or ifname = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(ifname) - string-length(translate(ifname, ',', ''))" {
          error-message
            "ifname must have one comma-separated entry per nexthop; an entry may be empty
             where that nexthop has no value for it.";
        }
        must "not(nexthop-vrf) or nexthop-vrf = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(nexthop-vrf) - string-length(translate(nexthop-vrf, ',', ''))" {
          error-message
            "nexthop-vrf must have one comma-separated entry per nexthop; an entry may be empty
             where that nexthop has no value for it.";
        }
        must "not(distance) or distance = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(distance) - string-length(translate(distance, ',', ''))" {
          error-message
            "distance must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        must "not(blackhole) or blackhole = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(blackhole) - string-length(translate(blackhole, ',', ''))" {
          error-message
            "blackhole must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        must "not(tag) or tag = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(tag) - string-length(translate(tag, ',', ''))" {
          error-message
            "tag must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        must "not(color) or color = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(color) - string-length(translate(color, ',', ''))" {
          error-message
            "color must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        must "not(bfd_detect_multiplier) or bfd_detect_multiplier = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(bfd_detect_multiplier) - string-length(translate(bfd_detect_multiplier, ',', ''))" {
          error-message
            "bfd_detect_multiplier must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        must "not(bfd_min_rx) or bfd_min_rx = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(bfd_min_rx) - string-length(translate(bfd_min_rx, ',', ''))" {
          error-message
            "bfd_min_rx must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        must "not(bfd_min_tx) or bfd_min_tx = '' or not(nexthop) or nexthop = ''"
           + " or string-length(nexthop) - string-length(translate(nexthop, ',', ''))"
           + "  = string-length(bfd_min_tx) - string-length(translate(bfd_min_tx, ',', ''))" {
          error-message
            "bfd_min_tx must have one comma-separated entry per nexthop, and every entry must
             carry a value.";
        }
        leaf prefix {
          type inet:ip-prefix;
          description
            "prefix is the destination IP address, as key";
        }
        leaf nexthop {
          type string;
          description
            "The next-hop that is to be used for the
             static route as IP address. When interface needs to be
             specified, use 0.0.0.0 as leaf value";
        }
        leaf ifname {
          type static-route-ifname-list;
          description
            "When interface is specified, forwarding happens through it. Comma-separated list
             with one entry per nexthop; an entry may be empty when its nexthop has none.";
        }
        leaf advertise {
          type static-route-flag;
          default "false";
          description
            "Advertise this static route to BGP. One value applies to the whole route.";
        }
<<<<<<< HEAD
