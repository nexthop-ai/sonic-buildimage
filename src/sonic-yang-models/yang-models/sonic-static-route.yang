module sonic-static-route {
  yang-version 1.1;
  namespace "http://github.com/sonic-net/sonic-static-route";
  prefix sroute;
  import ietf-inet-types {
    prefix inet;
  }
  organization
    "SONiC";
  contact
    "SONiC";
  description
    "STATIC ROUTE yang Module for SONiC OS";

  revision 2022-03-17 {
    description
      "First Revision";
  }

  container sonic-static-route {
    container STATIC_ROUTE {
      description
        "Static route entries for deterministic IP forwarding.";
      list STATIC_ROUTE_TEMPLATE_LIST {
        key "prefix";
        leaf prefix {
          type inet:ip-prefix;
          description
            "prefix is the destination IP address, as key";
        }
        leaf nexthop {
          type string;
          description
            "The next-hop that is to be used for the
             static route as IP address. When interface needs to be
             specified, use 0.0.0.0 as leaf value";
        }
        leaf ifname {
          type string;
          description
            "When interface is specified, forwarding happens through it";
        }
        leaf advertise {
          type string {
            pattern "((true|false),)*(true|false)";
          }
          default "false";
          description "Advertise this static route to BGP, comma-separated per nexthop.";
        }
        leaf bfd {
          type string {
            pattern "((true|false),)*(true|false)";
          }
          default "false";
          description "Enable BFD monitoring for each nexthop, comma-separated per nexthop.";
        }
      }
      list STATIC_ROUTE_LIST {
        key "vrf_name prefix";
        leaf vrf_name {
          type union {
            type string {
              pattern 'default';
            }
            type string {
              pattern 'mgmt';
            }
            type string {
              pattern "Vrf[a-zA-Z0-9_-]+";
            }
          }
          description
            "Virtual Routing Instance name as key";
        }
        leaf prefix {
          type inet:ip-prefix;
          description
            "prefix is the destination IP address, as key";
        }
        leaf nexthop {
          type string;
          description
            "The next-hop that is to be used for the
             static route as IP address. When interface needs to be
             specified, use 0.0.0.0 as leaf value";
        }
        leaf ifname {
          type string;
          description
            "When interface is specified, forwarding happens through it";
        }
        leaf advertise {
          type string {
            pattern "((true|false),)*(true|false)";
          }
          default "false";
          description "Advertise this static route to BGP, comma-separated per nexthop.";
        }
        leaf distance {
          type string {
            pattern "((25[0-5]|2[0-4][0-9]|[0-1]?[0-9][0-9]?),)*(25[0-5]|2[0-4][0-9]|[0-1]?[0-9][0-9]?)";
          }
          default "0";
          description
            "Administrative Distance (preference) of the entry.  The
             preference defines the order of selection when multiple
             sources (protocols, static, etc.) contribute to the same
             prefix entry.  The lower the preference, the more preferable the
             prefix is.  When this value is not specified, the preference is
             inherited from the default preference of the implementation for
             static routes.";
        }
        leaf nexthop-vrf {
          type string {
            pattern "((((Vrf[a-zA-Z0-9_-]+)|(default)|(mgmt)),)*((Vrf[a-zA-Z0-9_-]+)|(default)|(mgmt)))?";
          }
          description
            "VRF name of the nexthop. This is for vrf leaking";
        }
        leaf blackhole {
          type string {
            pattern "((true|false),)*(true|false)";
          }
          default "false";
          description
            "blackhole refers to a route that, if matched, discards the message silently.";
        }
      } /* end of list STATIC_ROUTE_LIST */
    } /* end of container STATIC_ROUTE */
  } /* end of container sonic-static_route */
}
=======
module sonic-static-route {
  yang-version 1.1;
  namespace "http://github.com/sonic-net/sonic-static-route";
  prefix sroute;

  import ietf-inet-types {
    prefix inet;
  }

  import sonic-bfd-profile {
    prefix bfdprofile;
  }

  import sonic-port {
    prefix port;
  }

  import sonic-portchannel {
    prefix lag;
  }

  import sonic-vlan {
    prefix vlan;
  }

  import sonic-vlan-sub-interface {
    prefix subintf;
  }

  import sonic-loopback-interface {
    prefix lointf;
  }

  organization
    "SONiC";
  contact
    "SONiC";
  description
    "STATIC ROUTE configuration";

  revision 2026-11-19 {
    description
      "ifname names its interface by leafref to PORT, PORTCHANNEL, VLAN,
       VLAN_SUB_INTERFACE or LOOPBACK_INTERFACE, so a nexthop cannot name an interface
       that does not exist and the interface's removal finds the nexthops that use it.
       The management port, the SRv6 encapsulation interface and 'none' remain
       patterns.";
  }

  revision 2026-09-03 {
    description
      "Add per-nexthop BFD monitoring: bfd, bfd-profile, bfd-source and bfd-multihop in
       static-route-nexthop-attributes. These map one-to-one onto FRR staticd's
       'ip route ... bfd [multi-hop] [source A] [profile P]' clause, so staticd owns the
       session and withdraws the nexthop itself while the session is down; no external
       daemon is involved. Timers come only from the referenced BFD_PROFILE entry.";
  }

  revision 2026-09-02 {
    description
      "Remove BFD configuration knobs: the route-level bfd flag on
       STATIC_ROUTE_LIST/STATIC_ROUTE_TEMPLATE_LIST, and the per-nexthop
       bfd_detect_multiplier/bfd_min_rx/bfd_min_tx leaves in
       static-route-nexthop-attributes. The model no longer exposes BFD as a
       configuration surface.";
  }

  revision 2026-08-28 {
    description
      "Model a nexthop as a row of its own. Every per-nexthop attribute -- nexthop,
       ifname, distance, nexthop-vrf, blackhole, tag, color, the three BFD timers, and
       the SRv6 segment list -- was a single string leaf holding a comma-separated
       list, positionally aligned with the nexthop list and checked only for entry
       count. That encoding cannot express two nexthops that differ solely by egress
       interface, which is ordinary IPv6 practice: the same link-local gateway reached
       over two interfaces is two forwarding paths and one string. It also pushed list
       parsing into every consumer and hid the nexthop[i] <-> distance[i] relationship
       from the schema.

       STATIC_ROUTE_NEXTHOP holds one entry per nexthop, keyed by gateway and egress
       interface -- the pair FRR itself identifies a nexthop by (frr-nexthop.yang keys
       on nh-type, vrf, gateway and interface). Each attribute becomes a scalar of its
       own type, so the nine comma-count must constraints per list are gone along with
       the regexes that encoded a list inside a pattern. STATIC_ROUTE keeps only the
       route-level advertise/bfd flags.

       A nexthop may legitimately have no gateway, or no interface, but a CONFIG_DB key
       is a '|'-joined string whose components are positional, and an empty component
       does not survive the round trip -- sonic-yang-mgmt rejects it on the way out and
       would silently shorten a trailing one, landing the row in the sibling list of
       lower arity. Both key leaves therefore take the literal 'none' for absence.
       'null' keeps its existing meaning of the null interface.

       The per-route sidlist list is replaced by a leaf-list on the nexthop: a segment
       list belongs to a nexthop, not to the whole route -- FRR accepts 'segments' only
       on route forms that take a nexthop, and never combined with blackhole -- and the
       name key it carried has no referent, since FRR's static-route grammar has no
       name for a segment list and the dataplane segment-list name is generated by
       zebra rather than supplied by CONFIG_DB. ifname additionally accepts sr[0-9]+,
       the SRv6 encapsulation interface a segment list forwards over.";
  }

  revision 2026-08-14 {
    description
      "bfd and advertise are single route-level flags, not per-nexthop lists: one value
       applies to the whole route, and when bfd is enabled one session is created per
       nexthop. ifname entries are constrained to interface-name forms. The per-nexthop
       lists must agree in entry count, so the leaves that carry them no longer declare a
       scalar default -- a single default value cannot be correct for a list whose length
       must match the nexthop count. A route may not be configured under both key shapes.";
  }

  revision 2026-07-21 {
    description
      "Align STATIC_ROUTE_TEMPLATE_LIST with STATIC_ROUTE_LIST (distance, nexthop-vrf, blackhole, sidlist)
       and add the route tag attribute to both lists.";
  }

  revision 2026-03-19 {
    description
      "Add SR-Policy color attribute for nexthops";
  }

  revision 2026-02-25 {
    description
      "Add sidlist for SRv6 traffic steering.";
  }

  revision 2025-12-09 {
    description
      "Add BFD custom timer parameters: bfd_detect_multiplier, bfd_min_rx, bfd_min_tx";
  }

  revision 2022-03-17 {
    description
      "First Revision";
  }

  typedef static-route-gateway {
    type union {
      type inet:ip-address;
      type string {
        pattern "none";
      }
    }
    description
      "A nexthop gateway address, or 'none' when the nexthop forwards through its egress
       interface alone. This is a key leaf, so it always carries a value; 'none' is what
       absence is spelled as, because an empty key component does not survive the
       CONFIG_DB round trip.";
  }

  typedef static-route-ifname {
    type union {
      type string {
        pattern "eth[0-9]+|sr[0-9]+|none";
      }
      type leafref {
        path "/port:sonic-port/port:PORT/port:PORT_LIST/port:name";
      }
      type leafref {
        path "/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name";
      }
      type leafref {
        path "/vlan:sonic-vlan/vlan:VLAN/vlan:VLAN_LIST/vlan:name";
      }
      type leafref {
        path "/subintf:sonic-vlan-sub-interface/subintf:VLAN_SUB_INTERFACE/subintf:VLAN_SUB_INTERFACE_LIST/subintf:name";
      }
      type leafref {
        path "/lointf:sonic-loopback-interface/lointf:LOOPBACK_INTERFACE/lointf:LOOPBACK_INTERFACE_LIST/lointf:name";
      }
    }
    description
      "The egress interface of one nexthop: a port, port channel, VLAN, VLAN
       sub-interface or loopback, each of which must exist in its table, or a
       management port. 'eth[0-9]+' is a pattern because eth0 is up without a MGMT_PORT
       row when ZTP brings it up on DHCP. 'none' means the nexthop has no egress
       interface and forwards to its gateway alone. 'sr[0-9]+' is the SRv6
       encapsulation interface a segment list forwards over; zebra creates it, so no
       table holds it.
       The string forms come first because PORT names are unpatterned, so a leafref
       listed first would claim every value. Internal port names (those with a '-',
       recycle ports among them) are refused by the must on each ifname leaf.";
  }

  typedef color-extcomm {
    type string {
      pattern
        '00:([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])';
    }
    description
      "A color extended community in type:value format. Only type 00 (and one color) is
       supported for now; the 'nn:' prefix reserves room for other extended-community
       types (e.g. 01, 10) without a future incompatible change to this leaf.";
  }

  grouping static-route-nexthop-attributes {
    description
      "The attributes of a single nexthop. Each is a scalar: the entry is one nexthop, so
       there is no list to align against another list.";

    leaf-list sidlist {
      type inet:ipv6-address;
      ordered-by user;
      description
        "SRv6 segment list (SID list) in traversal order: the first entry is the next
         segment after this node, and the last entry is the final segment, nearest the
         destination.";
    }
    leaf distance {
      type uint8 {
        range "1..255";
      }
      description
        "Administrative Distance (preference) of this nexthop. The preference defines the
         order of selection when multiple sources (protocols, static, etc.) contribute to
         the same prefix entry. The lower the preference, the more preferable the prefix
         is. When this value is not specified, the preference is inherited from the
         default preference of the implementation for static routes.";
    }
    leaf nexthop-vrf {
      type string {
        pattern "(Vrf[a-zA-Z0-9_-]+)|(default)|(mgmt)";
      }
      description
        "VRF name of this nexthop, used for VRF leaking.";
    }
    leaf blackhole {
      type boolean;
      default "false";
      description
        "This nexthop discards matching traffic silently.";
    }
    leaf tag {
      type uint32;
      description
        "Route tag applied to this nexthop. Value 0 means no tag is applied, matching the
         FRR 'tag (1-4294967295)' static-route parameter with 0 reserved to express the
         absence of a tag.";
    }
    leaf-list color {
      type color-extcomm;
      max-elements 1;
      description
        "SR-Policy color extended community for this nexthop, in type:value format
         (e.g. '00:100'). Absent means no SR-Policy color is associated with the
         nexthop. When specified, the static route will use the SR-Policy matching
         this color and the route's endpoint. Currently only type 00 and one color
         are supported.";
    }
    leaf bfd {
      type boolean;
      default "false";
      must ". = 'false' or (../gateway != 'none' and not(../blackhole = 'true'))" {
        error-message
          "bfd requires a gateway address to monitor: it cannot be enabled on an
           interface-only or blackhole nexthop.";
      }
      description
        "Monitor this nexthop with a BFD session to its gateway. While the session is
         down the nexthop is withheld from the routing table; the other nexthops of the
         route are unaffected. The session runs single-hop to the gateway with FRR's
         default timers unless bfd-multihop, bfd-source or bfd-profile say otherwise.";
    }
    leaf bfd-profile {
      type leafref {
        path "/bfdprofile:sonic-bfd-profile/bfdprofile:BFD_PROFILE"
           + "/bfdprofile:BFD_PROFILE_LIST/bfdprofile:name";
      }
      must "../bfd = 'true'" {
        error-message
          "bfd-profile applies only when bfd is enabled on the nexthop.";
      }
      description
        "BFD_PROFILE entry supplying the session's timers, multiplier and other session
         parameters. Absent means FRR's defaults. A BGP peer and a static nexthop with the
         same gateway share one BFD session; give both the same profile, since otherwise
         the registration that arrives last decides the session's parameters.";
    }
    leaf bfd-source {
      type inet:ip-address;
      must "../bfd = 'true'" {
        error-message
          "bfd-source applies only when bfd is enabled on the nexthop.";
      }
      must "contains(., ':') = contains(../gateway, ':')" {
        error-message
          "bfd-source must be in the same address family as gateway.";
      }
      description
        "Local address of the BFD session. Absent on a single-hop session means FRR
         resolves it from the egress interface, taking the address in the gateway's
         subnet when the interface has several; a multihop session must name one.";
    }
    leaf bfd-multihop {
      type boolean;
      default "false";
      must ". = 'false' or ../bfd = 'true'" {
        error-message
          "bfd-multihop applies only when bfd is enabled on the nexthop.";
      }
      must ". = 'false' or ../bfd-source" {
        error-message
          "bfd-multihop requires bfd-source: a multihop session cannot be keyed on
           'any' local address.";
      }
      description
        "Run the BFD session multihop, for a gateway that is not directly connected.
         A single-hop session to a recursive gateway never comes up and would keep the
         nexthop out of the routing table.";
    }
  }

  container sonic-static-route {
    container STATIC_ROUTE {
      description
        "Static route entries for deterministic IP forwarding. Route-level attributes
         only; each nexthop is a STATIC_ROUTE_NEXTHOP entry.";
      list STATIC_ROUTE_TEMPLATE_LIST {
        key "prefix";
        leaf prefix {
          type inet:ip-prefix;
          description
            "prefix is the destination IP address, as key";
        }
        leaf advertise {
          type boolean;
          default "false";
          description
            "Advertise this static route to BGP. One value applies to the whole route.";
        }
      }
      list STATIC_ROUTE_LIST {
        key "vrf_name prefix";
        must "not(vrf_name = 'default'"
           + "      and ../STATIC_ROUTE_TEMPLATE_LIST[prefix = current()/prefix])" {
          error-message
            "This prefix is configured twice: once with vrf default and once without, and
             both name the same route. Delete one of them. They can hold different
             nexthops, so keep the one carrying the settings that should survive.";
        }
        leaf vrf_name {
          type union {
            type string {
              pattern 'default';
            }
            type string {
              pattern 'mgmt';
            }
            type string {
              pattern "Vrf[a-zA-Z0-9_-]+";
            }
          }
          description
            "Virtual Routing Instance name as key";
        }
        leaf prefix {
          type inet:ip-prefix;
          description
            "prefix is the destination IP address, as key";
        }
        leaf advertise {
          type boolean;
          default "false";
          description
            "Advertise this static route to BGP. One value applies to the whole route.";
        }
      } /* end of list STATIC_ROUTE_LIST */
    } /* end of container STATIC_ROUTE */
    container STATIC_ROUTE_NEXTHOP {
      description
        "One entry per nexthop of a static route. A separate table because CONFIG_DB
         stores a row as a flat hash and cannot hold a keyed list inside a list; the two
         lists are told apart by key count, as the route lists above are.";
      list STATIC_ROUTE_TEMPLATE_NEXTHOP_LIST {
        key "prefix gateway ifname";
        must "gateway != 'none' or ifname != 'none' or blackhole = 'true'" {
          error-message
            "A nexthop must have a gateway, an egress interface, or be a blackhole. An
             entry with neither names no forwarding path.";
        }
        must "not(sidlist) or not(blackhole = 'true')" {
          error-message
            "FRR does not accept 'segments' on a blackhole route: sidlist cannot be
             combined with blackhole.";
        }
        must "not(sidlist) or not(color)" {
          error-message
            "sidlist and color are two different ways to select this nexthop's SRv6
             segments -- an explicit list here, or FRR looking up the SR-Policy
             matching color and the route's endpoint. Combining them on one
             nexthop is ambiguous.";
        }
        leaf prefix {
          type leafref {
            path "../../../STATIC_ROUTE/STATIC_ROUTE_TEMPLATE_LIST/prefix";
          }
          description
            "Prefix of the static route template this nexthop belongs to.";
        }
        leaf gateway {
          type static-route-gateway;
          description
            "Gateway address of this nexthop, or 'none'.";
        }
        leaf ifname {
          type static-route-ifname;
          must "not(contains(., '-'))" {
            error-message "An internal port is not a nexthop egress interface.";
          }
          description
            "Egress interface of this nexthop, or 'none'.";
        }
        uses static-route-nexthop-attributes;
      }
      list STATIC_ROUTE_NEXTHOP_LIST {
        key "vrf_name prefix gateway ifname";
        must "gateway != 'none' or ifname != 'none' or blackhole = 'true'" {
          error-message
            "A nexthop must have a gateway, an egress interface, or be a blackhole. An
             entry with neither names no forwarding path.";
        }
        must "not(sidlist) or not(blackhole = 'true')" {
          error-message
            "FRR does not accept 'segments' on a blackhole route: sidlist cannot be
             combined with blackhole.";
        }
        must "not(sidlist) or not(color)" {
          error-message
            "sidlist and color are two different ways to select this nexthop's SRv6
             segments -- an explicit list here, or FRR looking up the SR-Policy
             matching color and the route's endpoint. Combining them on one
             nexthop is ambiguous.";
        }
        must "../../STATIC_ROUTE/STATIC_ROUTE_LIST[vrf_name=current()/vrf_name][prefix=current()/prefix]" {
          error-message
            "vrf_name and prefix must together identify an existing STATIC_ROUTE_LIST
             entry: each leafref alone only checks that some entry has that vrf_name
             and some entry has that prefix, not that one entry has both.";
        }
        leaf vrf_name {
          type leafref {
            path "../../../STATIC_ROUTE/STATIC_ROUTE_LIST/vrf_name";
          }
          description
            "VRF of the static route this nexthop belongs to.";
        }
        leaf prefix {
          type leafref {
            path "../../../STATIC_ROUTE/STATIC_ROUTE_LIST/prefix";
          }
          description
            "Prefix of the static route this nexthop belongs to.";
        }
        leaf gateway {
          type static-route-gateway;
          description
            "Gateway address of this nexthop, or 'none'.";
        }
        leaf ifname {
          type static-route-ifname;
          must "not(contains(., '-'))" {
            error-message "An internal port is not a nexthop egress interface.";
          }
          description
            "Egress interface of this nexthop, or 'none'.";
        }
        uses static-route-nexthop-attributes;
      }
    } /* end of container STATIC_ROUTE_NEXTHOP */
  } /* end of container sonic-static_route */
}
>>>>>>> 5565c2323 (NOS-23414: [yang] Static route and BFD peer interfaces reference their interface tables (#13837))
