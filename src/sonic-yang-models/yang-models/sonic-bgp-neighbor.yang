        "BGP Neighbor configuration";

    revision 2026-11-19 {
        description
            "neighbor names a VLAN by leafref to VLAN and a sub-interface by leafref to
             VLAN_SUB_INTERFACE, so an unnumbered neighbor cannot name an interface that does
             not exist and the interface's removal finds the neighbors that use it.
             Vlan4095, which the VLAN name pattern admits, stays refused.";
    }

    revision 2026-09-20 {
        description
            "BGP_NEIGHBOR_LIST's asn requirement now also accepts peer_type
             alone under frrcfgd. peer_type also gets asn's ext:create-only
             refine.";
    }

    revision 2026-08-31 {
        description
            "Require an asn on both BGP neighbor lists, since a neighbor without one establishes no
             session. On BGP_NEIGHBOR_LIST it may be omitted only when frr_mgmt_framework_config is
             true and the neighbor has a peer_group_name or is attached to an interface. A neighbor
             that validated before this revision may now be rejected.";
    }

    revision 2026-06-02 {
        description
            "Expose BFD-for-BGP per-peer leaves (bfd, bfd_detect_multiplier, bfd_min_rx, bfd_min_tx,
             bfd_check_ctrl_plane_failure, bfd_profile) on BGP_NEIGHBOR_TEMPLATE_LIST via the updated
             sonic-bgp-cmn-neigh grouping, so bgpcfgd-mode BGP neighbors can be configured through
             CONFIG_DB/GCU/nhcli — matching what bgpd/templates/*/instance.conf.j2 already render.";
    }

    revision 2026-01-14 {
        description
            "Add v6only leaf and interface neighbor support for BGP_NEIGHBOR_TEMPLATE_LIST (bgpcfgd mode).
             Refactor neighbor and v6only into sonic-bgp-neigh-attrs grouping.";
    }

    revision 2026-01-10 {
        description
            "Add v6only leaf for interface-based BGP neighbors.";
    }
