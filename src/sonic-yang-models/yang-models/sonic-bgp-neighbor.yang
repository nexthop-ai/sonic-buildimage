    grouping sonic-bgp-neigh-attrs {
        description "Common neighbor and v6only attributes for BGP neighbors";

        leaf neighbor {
            must "current() != 'Vlan4095'" {
                error-message "Vlan4095 is reserved; a VLAN ID runs up to 4094.";
            }
            type union {
                type inet:ip-address;
                type leafref {
                    path "/port:sonic-port/port:PORT/port:PORT_LIST/port:name";
                }
                type leafref {
                    path "/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name";
                }
                type leafref {
                    path "/vlan:sonic-vlan/vlan:VLAN/vlan:VLAN_LIST/vlan:name";
                }
                type leafref {
                    path "/subintf:sonic-vlan-sub-interface/subintf:VLAN_SUB_INTERFACE/subintf:VLAN_SUB_INTERFACE_LIST/subintf:name";
                }
            }
            description
                "BGP neighbor address, or the port, port channel, VLAN or VLAN sub-interface of an
                 unnumbered neighbor; the interface must exist in its table.";
        }

        leaf v6only {
            type boolean;
            default false;
            description "When set to 'true' it will create a neighbor with v6 link local only.";
            must "current() = 'false' or starts-with(../neighbor, 'Eth') or starts-with(../neighbor, 'Po') or starts-with(../neighbor, 'Vlan')" {
                error-message "v6only can only be configured for interface-based BGP neighbors";
            }
        }
    }

