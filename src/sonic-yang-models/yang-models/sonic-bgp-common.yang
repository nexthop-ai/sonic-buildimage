module sonic-bgp-common {
    namespace "http://github.com/sonic-net/sonic-bgp-common";
    prefix bgpcmn;
    yang-version 1.1;

    import sonic-types {
        prefix stypes;
    }

    import ietf-inet-types {
        prefix inet;
    }

    import sonic-port {
        prefix port;
    }

    import sonic-portchannel {
        prefix lag;
    }

  // Comment sonic-vlan import here until libyang back-links issue is resolved for VLAN leaf reference.
  //  import sonic-vlan {
  //      prefix vlan;
  //  }

    import sonic-loopback-interface {
        prefix lointf;
    }

    import sonic-routing-policy-sets {
        prefix rpolsets;
    }

    import sonic-route-map {
        prefix rmap;
    }

    import sonic-extension {
        prefix ext;
    }

    organization
        "SONiC";

    contact
        "SONiC";

    description
<<<<<<< HEAD
        "SONIC BGP common YANG attributes for Neighbors and Peer group";
=======
        "BGP common attributes for neighbors and peer groups";

    revision 2026-08-10 {
        description
            "Extend the per-peer graceful_shutdown / graceful_restart / graceful_restart_disable / graceful_restart_helper leaves to bgpcfgd (separated) mode for BGP_NEIGHBOR, so the same CONFIG_DB drives FRR under either mode. No schema change; description text only. BGP_PEER_GROUP remains frrcfgd-only because bgpcfgd has no BGP_PEER_GROUP consumer.";
    }

    revision 2026-07-28 {
        description
            "Add per-peer graceful_shutdown, graceful_restart, graceful_restart_disable and graceful_restart_helper leaves to sonic-bgp-cmn so BGP_NEIGHBOR_LIST and BGP_PEER_GROUP_LIST (frrcfgd mode) can drive per-neighbor / per-peer-group BGP graceful-shutdown and graceful-restart, overriding the global BGP_GLOBALS settings. The three graceful-restart mode leaves are mutually exclusive, matching FRR's single per-peer graceful-restart mode.";
    }

    revision 2026-07-23 {
        description
            "Restrict per-peer bfd_min_rx and bfd_min_tx to 100 or 1000 ms for async BFD-for-BGP; hardware BFD offload only supports these timer values. Also require a bfd_profile, or all of bfd_detect_multiplier / bfd_min_rx / bfd_min_tx, whenever bfd is enabled (FRR's inline BFD needs all three; no session left at an unset default). Aligns with sonic-bfd-profile async timer restriction.";
    }

    revision 2026-07-22 {
        description
            "Add bgp_afi_safi typedef (and the bgp_afi_safi_global / bgp_afi_safi_device_global
             restrictions) and use it for the afi_safi list keys, which were previously an
             unconstrained 'type string'. Constraining the key rejects non-canonical
             spellings such as 'ipv4-unicast' at validation time and lets YANG-derived
             CLIs offer the valid values as completion candidates.";
    }

    revision 2026-06-02 {
        description
            "Extract BFD leaves into sonic-bgp-cmn-bfd grouping and use it from sonic-bgp-cmn-neigh so BGP_NEIGHBOR_TEMPLATE_LIST (bgpcfgd mode), BGP_INTERNAL_NEIGHBOR_LIST, BGP_VOQ_CHASSIS_NEIGHBOR_LIST and BGP_MONITORS_LIST expose the same BFD config the bgpcfgd templates already render.";
    }

    revision 2026-04-29 {
        description
            "Add bfd_profile leafref into sonic-bfd-profile/BFD_PROFILE/name; align bfd_min_rx and bfd_min_tx ranges with BFD_PROFILE timer ranges.";
    }

    revision 2026-04-23 {
        description
            "Add bgp_origin_type typedef for BGP origin attribute in aggregate addresses.";
    }

    revision 2026-04-22 {
        description
            "Add BGP address-family level add-path configuration parameters supported by FRR to
             sonic-bgp-cmn-af grouping: add tx_best_selected enum to bgp_tx_addpaths_type,
             add bgp_tx_add_paths_max_best_selected (uint8, 1..6, default 1).";
    }

    revision 2025-12-09 {
        description
            "Add BFD custom timer parameters: bfd_detect_multiplier, bfd_min_rx, bfd_min_tx";
    }
>>>>>>> ea6e4f2d8 (NOS-9006: Adding SONiC YANG/model support for neighbor and peer-group BGP graceful control knobs (#7327))

    revision 2021-02-26 {
        description
            "Initial revision.";
    }

    typedef bgp_peer_type {
        type enumeration {
            enum internal {
                description "Internal peer";
            }
            enum external {
                description "External peer";
            }
        }
    }

    typedef bgp_tx_add_paths_type {
        type enumeration {
            enum tx_all_paths {
                description
                    "Send multiple path advertisements for an NLRI from
                    the neighbor or group";
            }
            enum tx_best_path_per_as {
                description
                    "Send only best path per AS advertisements for an NLRI from
                    the neighbor or group";
            }
        }
        description
            "Type to describe the add paths advertisement method.";
    }

    typedef bgp_community_type {
        type enumeration {
            enum standard {
                description "Standard communities";
            }

            enum extended {
                description "Extended communities";
            }

            enum both {
                description "Both standard and extended communities";
            }

            enum large {
                description "Large communities";
            }

            enum all {
                description "Standard, Extended and Large communities";
            }

            enum none {
                description "No community attribute";
            }
        }
        description
            "type describing variations of community attributes";
    }

    typedef sonic_bgp_direction {
        type enumeration {
            enum in {
                description
                    "Refers to information received from the BGP peer";
            }
            enum out {
                description
                    "Refers to information advertised to the BGP peer";
            }
        }
        description
            "Type to describe the direction";
    }

    typedef sonic_bgp_orf {
        type enumeration {
            enum send {
                description
                    "Capability to receive the outbound route filtering from this neighbor";
            }
            enum receive {
                description
                    "Capability to send the outbound route filtering to this neighbor";
            }
            enum both {
                description
                    "Capability to send and receive the outbound route filtering to/from this neighbor";
            }
        }
        description
            "Type to describe the BGP ORF(Outbound route filtering) capability";
    }

    grouping sonic-bgp-cmn {

        leaf local_asn {
            type uint32 {
                range "1..4294967295";
            }
            description "Local AS number";
        }

        leaf name {
            type string;
            description "Peer description";
        }

        leaf asn {
            type uint32 {
                range "1..4294967295";
            }
            description "Peer AS number";
        }

        leaf peer_type {
            type bgp_peer_type;
            description "BGP peer type internal/external";
        }

        leaf ebgp_multihop {
            type boolean;
            description "Enable eBGP multihop to allow peering with non-directly-connected external neighbors.";
        }

        leaf ebgp_multihop_ttl {
            type uint8 {
                range "1..255";
            }
            description "Maximum number of hops for eBGP multihop sessions.";
        }

        leaf auth_password {
            type string;
            description "MD5 authentication password for the BGP session.";
        }

        leaf keepalive {
            type uint16;
            description "BGP keepalive interval in seconds.";
        }

        leaf holdtime {
            type uint16;
            description "BGP hold time in seconds; session is reset if no keepalive is received within this period.";
        }

        leaf conn_retry {
            type uint16 {
                range "1..65535";
            }
            description "BGP connect retry timer in seconds.";
        }

        leaf min_adv_interval {
            type uint16 {
                range "0..600";
            }
            description "Minimum interval in seconds between sending BGP route updates to a peer.";
        }

        leaf local_addr {
            type union {
                type inet:ip-address;
                type leafref {
                    path "/port:sonic-port/port:PORT/port:PORT_LIST/port:name";
                }
                type leafref {
                    path "/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name";
                }
                // Comment VLAN leaf reference here until libyang back-links issue is resolved and use VLAN string pattern
                //type leafref {
                //    path "/vlan:sonic-vlan/vlan:VLAN/vlan:VLAN_LIST/vlan:name";
                //}
                type leafref {
                    path "/lointf:sonic-loopback-interface/lointf:LOOPBACK_INTERFACE/lointf:LOOPBACK_INTERFACE_LIST/lointf:name";
                }
                type string {
                    pattern 'Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])';
                }
            }
            description "Local source address or interface name to use for connection.";
        }

        leaf passive_mode {
            type boolean;
            description "Wait for the peer to initiate the BGP session instead of actively connecting.";
        }

        leaf capability_ext_nexthop {
            type boolean;
            description "Advertise extended nexthop capability to allow IPv4 prefixes over IPv6 nexthops.";
        }

        leaf disable_ebgp_connected_route_check {
            type boolean;
            description "Disable the check that an eBGP peer's address must be a connected route.";
            //ext:custom-validation ValidateDisableConnectedCheck;
        }

        leaf enforce_first_as {
            type boolean;
            description "Require the first AS in the AS path to be the peer's AS number for eBGP sessions.";
        }

        leaf solo_peer {
            type boolean;
            description "Place this peer in its own update group to prevent route sharing with other peers.";
        }

        leaf ttl_security_hops {
            type uint8 {
                range 1..254;
            }
            description "Maximum number of hops expected for the BGP TTL security mechanism (GTSM).";
        }

        leaf bfd {
            type boolean;
            description "Enable Bidirectional Forwarding Detection (BFD) for rapid link failure detection on this peer.";
        }

        leaf bfd_check_ctrl_plane_failure {
            type boolean;
            description "Trigger BGP session reset when a BFD control plane failure is detected.";
        }

        leaf capability_dynamic {
            type boolean;
            description "Advertise dynamic capability";
        }

        leaf dont_negotiate_capability {
            type boolean;
            description "Do not perform capability negotiation";
        }

        leaf enforce_multihop {
            type boolean;
            description "Enforce EBGP neighbors perform multihop";
        }

        leaf override_capability {
            type boolean;
            description "Override capability negotiation result";
        }

        leaf graceful_shutdown {
            type boolean;
            description
                "Gracefully shut down this BGP peer (RFC 8326): attach the GRACEFUL_SHUTDOWN community and lower LOCAL_PREF so peers deprefer these paths while the session stays up. Overrides the global graceful-shutdown for this peer. Honored under BGP_NEIGHBOR in both modes: frrcfgd / unified mode (DEVICE_METADATA frr_mgmt_framework_config true) and bgpcfgd / separated mode. Under BGP_PEER_GROUP it is frrcfgd-only, because bgpcfgd does not consume the BGP_PEER_GROUP table.";
        }

        leaf graceful_restart {
            type boolean;
            must "current() = 'false' or not(../graceful_restart_disable = 'true' or ../graceful_restart_helper = 'true')" {
                error-message "graceful_restart, graceful_restart_disable and graceful_restart_helper are mutually exclusive; FRR keeps a single per-peer graceful-restart mode, so at most one may be true";
            }
            description
                "Enable BGP graceful restart (restarter and helper) for this peer, overriding the global graceful-restart setting. Honored under BGP_NEIGHBOR in both modes: frrcfgd / unified mode (DEVICE_METADATA frr_mgmt_framework_config true) and bgpcfgd / separated mode. Under BGP_PEER_GROUP it is frrcfgd-only, because bgpcfgd does not consume the BGP_PEER_GROUP table.";
        }

        leaf graceful_restart_disable {
            type boolean;
            must "current() = 'false' or not(../graceful_restart = 'true' or ../graceful_restart_helper = 'true')" {
                error-message "graceful_restart, graceful_restart_disable and graceful_restart_helper are mutually exclusive; FRR keeps a single per-peer graceful-restart mode, so at most one may be true";
            }
            description
                "Disable BGP graceful restart for this peer, overriding the global graceful-restart setting. Honored under BGP_NEIGHBOR in both modes: frrcfgd / unified mode (DEVICE_METADATA frr_mgmt_framework_config true) and bgpcfgd / separated mode. Under BGP_PEER_GROUP it is frrcfgd-only, because bgpcfgd does not consume the BGP_PEER_GROUP table.";
        }

        leaf graceful_restart_helper {
            type boolean;
            must "current() = 'false' or not(../graceful_restart = 'true' or ../graceful_restart_disable = 'true')" {
                error-message "graceful_restart, graceful_restart_disable and graceful_restart_helper are mutually exclusive; FRR keeps a single per-peer graceful-restart mode, so at most one may be true";
            }
            description
                "Enable graceful-restart helper-only mode for this peer. Honored under BGP_NEIGHBOR in both modes: frrcfgd / unified mode (DEVICE_METADATA frr_mgmt_framework_config true) and bgpcfgd / separated mode. Under BGP_PEER_GROUP it is frrcfgd-only, because bgpcfgd does not consume the BGP_PEER_GROUP table.";
        }

        leaf peer_port {
            type uint16;
            description "Peer port number";
        }

        leaf shutdown_message {
            type string {
                length "1..127";
            }
            description "Human-readable message sent in the BGP NOTIFICATION when administratively shutting down the peer.";
        }

        leaf strict_capability_match {
            type boolean;
            //ext:custom-validation ValidateStrictAndOverRideCapability;
            description "Require exact match of capabilities; tear down session if capabilities do not match.";
        }

        leaf admin_status {
            type stypes:admin_status;
            description "Administrative status to enable or disable this BGP peer.";
        }

        leaf local_as_no_prepend {
            type boolean;
            description "Do not prepend the local AS number to updates received from eBGP peers.";
        }

        leaf local_as_replace_as {
            type boolean;
            description "Replace the real AS number with the local AS number in outbound updates.";
        }
    }


    grouping sonic-bgp-cmn-af {

        leaf afi_safi {
            type string;
            description "Address family";
        }

        leaf admin_status {
            type stypes:admin_status;
            description "Indicates address family active/inactive status";
        }

        leaf send_default_route {
            type boolean;
            description "Originate a default route to this neighbor.";
        }

        leaf default_rmap {
            type leafref {
                path "/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name";
            }
            description "Route map applied when originating a default route to this neighbor.";
        }

        leaf max_prefix_limit {
            type uint32;
            description "Maximum number of prefixes accepted from this neighbor before taking action.";
        }

        leaf max_prefix_warning_only {
            type boolean;
            description "Only log a warning instead of tearing down the session when the maximum prefix limit is exceeded.";
        }

        leaf max_prefix_warning_threshold {
            type uint8 {
                range "1..100";
            }
            description "Percentage of the maximum prefix limit at which a warning is generated.";
        }

        leaf max_prefix_restart_interval {
            type uint16 {
                range "1..65535";
            }
            description "Time in seconds to wait before re-establishing the session after a max-prefix limit shutdown.";
        }

        leaf-list route_map_in {
            type leafref {
                path "/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name";
            }
            ordered-by user;
            description "Route-map filter for incoming routes";
            max-elements 1;
        }

        leaf-list route_map_out {
            type leafref {
                path "/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name";
            }
            ordered-by user;
            description "Route-map filter for outgoing routes";
            max-elements 1;
        }

        leaf soft_reconfiguration_in {
            type boolean;
            description "Enable storing of inbound updates to allow route refresh without resetting the session.";
        }

        leaf unsuppress_map_name {
            type leafref {
                path "/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name";
            }
            description "Route map used to selectively unsuppress suppressed routes to this neighbor.";
        }

        leaf rrclient {
            type boolean;
            description "Configure this neighbor as a route reflector client.";
        }

        leaf weight {
            type uint16 {
                range 0..65535;
            }
            description "Default weight assigned to routes received from this neighbor for best-path selection.";
        }

        leaf as_override {
            type boolean;
            description "Replace the peer AS number with the local AS in outbound updates to prevent loops in dual-homed networks.";
        }

        leaf send_community {
            type bgp_community_type;
            description "Send Community attribute to this neighbor";
        }

        leaf tx_add_paths {
            type bgp_tx_add_paths_type;
            description "Advertise all paths or best path per AS using add path";
        }

        leaf unchanged_as_path {
            type boolean;
            description "Propagate the AS path attribute unchanged to this neighbor.";
        }

        leaf unchanged_med{
            type boolean;
            description "Propagate the MED attribute unchanged to this neighbor.";
        }

        leaf unchanged_nexthop {
            type boolean;
            description "Propagate the nexthop attribute unchanged to this neighbor.";
        }

        leaf filter_list_in {
            type leafref {
                path "/rpolsets:sonic-routing-policy-sets/rpolsets:AS_PATH_SET/rpolsets:AS_PATH_SET_LIST/rpolsets:name";
            }
            description "AS-path access list name for filtering inbound routes.";
        }

        leaf filter_list_out {
            type leafref {
                path "/rpolsets:sonic-routing-policy-sets/rpolsets:AS_PATH_SET/rpolsets:AS_PATH_SET_LIST/rpolsets:name";
            }
            description "AS-path access list name for filtering outbound routes.";
        }

        leaf nhself {
            type boolean;
            description "Nexthop is self, no nexthop calculation";
        }

        leaf nexthop_self_force {
            type boolean;
            description "Force nexthop to be self for reflected routes";
        }

        leaf prefix_list_in {
            type leafref {
                path "/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name";
            }
            description "Prefix list name for filtering inbound routes.";
        }

        leaf prefix_list_out {
            type leafref {
                path "/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name";
            }
            description "Prefix list name for filtering outbound routes.";
        }

        leaf remove_private_as_enabled {
            type boolean;
            description "Remove private AS numbers from the AS path in outbound updates.";
        }

        leaf replace_private_as {
            type boolean;
            description "Replace private AS numbers with the local AS number in outbound updates.";
        }

        leaf remove_private_as_all {
            type boolean;
            description "Remove all private AS numbers (including in the middle of the path) from outbound updates.";
        }

        leaf allow_as_in {
            type boolean;
            description "Accept inbound routes even when the local AS number appears in the AS path.";
        }

        leaf allow_as_count {
            type uint8;
            description "Maximum number of times the local AS number may appear in a received AS path.";
        }

        leaf allow_as_origin {
            type boolean;
            description "Accept routes that originated from the local AS.";
        }

        leaf cap_orf {
            type sonic_bgp_orf;
            description "Outbound Route Filtering (ORF) prefix-list capability to negotiate with this neighbor.";
        }

        leaf route_server_client {
            type boolean;
            description "Configure this neighbor as a route server client, disabling attribute modification.";
        }
    }

    grouping sonic-bgp-cmn-neigh {
        leaf asn {
            type uint32 {
                range "0..4294967295";
            }
            description "Peer AS number.";
        }

        leaf holdtime {
            type uint16;
            description "BGP hold time in seconds; session is reset if no keepalive is received within this period.";
        }

        leaf keepalive {
            type uint16;
            description "BGP keepalive interval in seconds.";
        }

        leaf local_addr {
            type inet:ip-address;
            description "Local source address to use for the BGP session.";
        }

        leaf name {
            type string;
            description "Human-readable description text for this BGP peer.";
        }

        leaf nhopself {
            type uint8 {
                range "0..1";
            }
            description "Set nexthop to self for routes advertised to this peer.";
        }

        leaf rrclient {
            type uint8 {
                range "0..1";
            }
            description "Configure this neighbor as a route reflector client.";
        }

        leaf admin_status {
            type stypes:admin_status;
            description "Administrative status to enable or disable this BGP peer.";
        }
    }
}
