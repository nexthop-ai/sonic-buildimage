diff --git a/bgpd/bgp_zebra.c b/bgpd/bgp_zebra.c
index 73849dcf39..faa7337c00 100644
--- a/bgpd/bgp_zebra.c
+++ b/bgpd/bgp_zebra.c
@@ -33,6 +33,8 @@
 #include "bgpd/bgp_nexthop.h"
 #include "bgpd/bgp_zebra.h"
 #include "bgpd/bgp_fsm.h"
+#include "bgpd/bgp_packet.h"
+#include "bgpd/bgp_updgrp.h"
 #include "bgpd/bgp_debug.h"
 #include "bgpd/bgp_errors.h"
 #include "bgpd/bgp_mpath.h"
@@ -300,6 +302,108 @@ static int bgp_interface_link_params(ZAPI_CALLBACK_ARGS)
 	return 0;
 }
 
+/* A peer can only have been wedged in an address family that can carry an IPv6
+ * next-hop: a negotiated IPv6 AF, where a link-local next-hop is mandatory for a
+ * directly connected peer (RFC 2545), or an IPv4 AF with ENHE (RFC 8950).
+ * Anything else never reaches the ifp checks in bgp_mp_reach_parse().
+ */
+static bool bgp_nexthop_af_may_wedge(struct peer *peer, afi_t afi, safi_t safi)
+{
+	if (!peer->afc_nego[afi][safi])
+		return false;
+
+	return afi == AFI_IP6 || peer_cap_enhe(peer, afi, safi);
+}
+
+static bool bgp_nexthop_peer_may_wedge(struct peer *peer)
+{
+	afi_t afi;
+	safi_t safi;
+
+	FOREACH_AFI_SAFI (afi, safi)
+		if (bgp_nexthop_af_may_wedge(peer, afi, safi))
+			return true;
+
+	return false;
+}
+
+/* peer->nexthop is resolved once, in bgp_getsockname(), when the TCP connection
+ * comes up. Before zebra has handed over the interface table there is nothing to
+ * resolve against, and bgp_zebra_nexthop_set() reports success with a NULL ifp
+ * rather than failing the connection. Nothing re-derives it afterwards, so such a
+ * peer rejects every MP_REACH_NLRI carrying a link-local next-hop - which for a
+ * directly connected IPv6 peer is every update - for the life of the session.
+ * The drop happens in the attribute parser, so a soft-in has nothing to replay
+ * and only a resend recovers the prefixes.
+ */
+static void bgp_nexthop_resolve_deferred(struct bgp *bgp)
+{
+	struct listnode *node, *nnode;
+	struct peer *peer;
+	afi_t afi;
+	safi_t safi;
+
+	for (ALL_LIST_ELEMENTS(bgp->peer, node, nnode, peer)) {
+		struct bgp_nexthop nexthop;
+		bool shared_network;
+
+		if (peer->nexthop.ifp || !peer_established(peer->connection))
+			continue;
+
+		nexthop = peer->nexthop;
+		shared_network = peer->shared_network;
+
+		/* A partial result - interface found, but not yet the link-local
+		 * address the outgoing next-hop needs - must not latch, or the
+		 * ifp test above would skip this peer for every later address.
+		 */
+		if (!bgp_zebra_nexthop_set(peer->connection->su_local,
+					   peer->connection->su_remote,
+					   &peer->nexthop, peer)) {
+			peer->nexthop = nexthop;
+			peer->shared_network = shared_network;
+			continue;
+		}
+
+		/* The re-resolve above is what every peer needed; only a peer
+		 * that could have been wedged has anything to re-learn. For the
+		 * rest, shared_network does not key their update-group and
+		 * nexthop.v4 was already correct, so a resend is pure waste - and
+		 * a reset would tear down a session that was never broken.
+		 */
+		if (!bgp_nexthop_peer_may_wedge(peer))
+			continue;
+
+		if (!CHECK_FLAG(peer->cap, PEER_CAP_REFRESH_RCV)) {
+			zlog_info("%pBP resolved to interface %s, resetting to re-learn prefixes",
+				  peer, peer->nexthop.ifp->name);
+			peer_set_last_reset(peer, PEER_DOWN_CEASE_CONFIG_CHANGE);
+			peer_notify_config_change(peer->connection);
+			continue;
+		}
+
+		zlog_info("%pBP resolved to interface %s, refreshing prefixes", peer,
+			  peer->nexthop.ifp->name);
+
+		/* The outgoing next-hop encoding changed along with the
+		 * interface, so what is already advertised has to be re-sent as
+		 * well as what was dropped inbound. shared_network keys the
+		 * update-group - it decides whether the v6 next-hop is encoded
+		 * as 32 bytes or 16 - so the peer has to be regrouped first, or
+		 * the re-announcement goes out with the old encoding.
+		 */
+		update_group_adjust_peer_afs(peer);
+
+		FOREACH_AFI_SAFI (afi, safi) {
+			if (!bgp_nexthop_af_may_wedge(peer, afi, safi))
+				continue;
+			bgp_route_refresh_send(peer, afi, safi, 0, 0, 0,
+					       BGP_ROUTE_REFRESH_NORMAL);
+			bgp_announce_route(peer, afi, safi, true);
+		}
+	}
+}
+
 static int bgp_interface_address_add(ZAPI_CALLBACK_ARGS)
 {
 	struct connected *ifc;
@@ -327,6 +431,8 @@ static int bgp_interface_address_add(ZAPI_CALLBACK_ARGS)
 	if (if_is_operative(ifc->ifp)) {
 		bgp_connected_add(bgp, ifc);
 
+		bgp_nexthop_resolve_deferred(bgp);
+
 		/* If we have learnt of any neighbors on this interface,
 		 * check to kick off any BGP interface-based neighbors,
 		 * but only if this is a link-local address.
