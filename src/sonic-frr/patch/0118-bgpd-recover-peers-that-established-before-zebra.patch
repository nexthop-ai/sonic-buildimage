--- /dev/null
+++ b/tests/topotests/bgp_nexthop_ifp_late_zebra/test_bgp_nexthop_ifp_late_zebra.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python
+# SPDX-License-Identifier: ISC
+
+"""
+A peer that reaches Established before bgpd has ever talked to zebra has no
+interface for its nexthop, so it treats every update carrying a link-local
+next-hop as a withdrawal. Check that the prefixes are re-learned once zebra
+delivers the interface addresses, instead of the session staying up empty.
+
+r2 negotiates route refresh and is recovered in place. r3 does not, and is
+expected to be reset instead - the only other way to re-learn.
+"""
+
+import json
+import os
+import sys
+
+import pytest
+
+CWD = os.path.dirname(os.path.realpath(__file__))
+sys.path.append(os.path.join(CWD, "../"))
+
+# pylint: disable=C0413
+from lib import topotest
+from lib.topogen import Topogen, TopoRouter, get_topogen
+
+pytestmark = [pytest.mark.bgpd]
+
+R1_TO_R2 = "2001:db8:1::1"
+R2_ADDR = "2001:db8:1::2"
+R1_TO_R3 = "2001:db8:2::1"
+R3_ADDR = "2001:db8:2::3"
+REDISTRIBUTED_PREFIX = "2001:db8:f::1/128"
+
+
+def build_topo(tgen):
+    for routern in range(1, 4):
+        tgen.add_router("r{}".format(routern))
+
+    switch = tgen.add_switch("s1")
+    switch.add_link(tgen.gears["r1"])
+    switch.add_link(tgen.gears["r2"])
+
+    switch = tgen.add_switch("s2")
+    switch.add_link(tgen.gears["r1"])
+    switch.add_link(tgen.gears["r3"])
+
+
+def setup_module(mod):
+    tgen = Topogen(build_topo, mod.__name__)
+    tgen.start_topology()
+
+    for rname, router in tgen.routers().items():
+        router.load_config(
+            TopoRouter.RD_ZEBRA, os.path.join(CWD, "{}/zebra.conf".format(rname))
+        )
+        router.load_config(
+            TopoRouter.RD_BGP, os.path.join(CWD, "{}/bgpd.conf".format(rname))
+        )
+
+    tgen.gears["r1"].net.daemons["zebra"] = 0
+    tgen.start_router()
+
+    # r1's bgpd has no zebra to configure its peering addresses, and no
+    # interface to derive a router-id from - the latter is in r1/bgpd.conf.
+    tgen.gears["r1"].run("ip -6 addr add {}/64 dev r1-eth0".format(R1_TO_R2))
+    tgen.gears["r1"].run("ip -6 addr add {}/64 dev r1-eth1".format(R1_TO_R3))
+
+
+def teardown_module(mod):
+    tgen = get_topogen()
+    tgen.stop_topology()
+
+
+def _neighbor(router, addr):
+    return json.loads(router.vtysh_cmd("show bgp neighbors {} json".format(addr)))[addr]
+
+
+def test_session_establishes_without_zebra():
+    """The sessions come up, and r1 accepts nothing over them."""
+    tgen = get_topogen()
+
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    r1 = tgen.gears["r1"]
+    r2 = tgen.gears["r2"]
+
+    # Assert the advertisement first: r1 reporting zero prefixes is trivially
+    # true in the moment before r2 has sent anything.
+    def _r2_advertised():
+        output = json.loads(
+            r2.vtysh_cmd(
+                "show bgp ipv6 unicast neighbors {} advertised-routes json".format(
+                    R1_TO_R2
+                )
+            )
+        )
+        return topotest.json_cmp(
+            output, {"advertisedRoutes": {REDISTRIBUTED_PREFIX: {}}}
+        )
+
+    _, result = topotest.run_and_expect(_r2_advertised, None, count=60, wait=1)
+    assert result is None, "r2 never advertised {} to r1".format(REDISTRIBUTED_PREFIX)
+
+    def _established_with_no_prefixes():
+        output = json.loads(r1.vtysh_cmd("show bgp ipv6 unicast summary json"))
+        return topotest.json_cmp(
+            output, {"peers": {R2_ADDR: {"state": "Established", "pfxRcd": 0}}}
+        )
+
+    _, result = topotest.run_and_expect(
+        _established_with_no_prefixes, None, count=60, wait=1
+    )
+    assert result is None, "r1 did not reach Established with an empty table"
+
+    def _r3_established_once():
+        return topotest.json_cmp(
+            _neighbor(r1, R3_ADDR),
+            {"bgpState": "Established", "connectionsEstablished": 1},
+        )
+
+    _, result = topotest.run_and_expect(_r3_established_once, None, count=60, wait=1)
+    assert result is None, "r3 session did not come up exactly once"
+
+
+def test_prefixes_relearned_once_zebra_starts():
+    """Starting zebra resolves the interface and pulls the prefixes back."""
+    tgen = get_topogen()
+
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    r1 = tgen.gears["r1"]
+    r1.startDaemons(["zebra"])
+
+    def _prefix_learned():
+        output = json.loads(
+            r1.vtysh_cmd("show bgp ipv6 unicast {} json".format(REDISTRIBUTED_PREFIX))
+        )
+        return topotest.json_cmp(output, {"prefix": REDISTRIBUTED_PREFIX})
+
+    _, result = topotest.run_and_expect(_prefix_learned, None, count=60, wait=1)
+    assert result is None, "r1 did not re-learn {} after zebra started".format(
+        REDISTRIBUTED_PREFIX
+    )
+
+
+def test_peer_without_route_refresh_is_reset():
+    """r3 cannot be refreshed in place, so it is reset instead."""
+    tgen = get_topogen()
+
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    r1 = tgen.gears["r1"]
+
+    def _r3_reconnected():
+        neighbor = _neighbor(r1, R3_ADDR)
+        if neighbor.get("connectionsEstablished", 0) < 2:
+            return "r3 not reset yet: {}".format(
+                neighbor.get("connectionsEstablished")
+            )
+        # The reset cause distinguishes our CEASE from an unrelated hold-timer
+        # expiry, which would also bump connectionsEstablished.
+        return topotest.json_cmp(
+            neighbor,
+            {
+                "bgpState": "Established",
+                "lastResetDueTo": "Cease: other config change",
+            },
+        )
+
+    _, result = topotest.run_and_expect(_r3_reconnected, None, count=60, wait=1)
+    assert result is None, "r3 was not reset and re-established after zebra started"
+
+
+if __name__ == "__main__":
+    args = ["-s"] + sys.argv[1:]
+    sys.exit(pytest.main(args))
