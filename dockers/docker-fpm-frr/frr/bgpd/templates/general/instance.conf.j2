{# Per-peer graceful control knobs, overriding the BGP_GLOBALS setting #}
{% if 'graceful_shutdown' in bgp_session and bgp_session['graceful_shutdown'] == 'true' %}
  neighbor {{ neighbor_addr }} graceful-shutdown
{% endif %}
{# FRR keeps a single per-peer graceful-restart mode, so only one of the three
   may be rendered; YANG rejects a config with more than one set to true. #}
{% if 'graceful_restart' in bgp_session and bgp_session['graceful_restart'] == 'true' %}
  neighbor {{ neighbor_addr }} graceful-restart
{% elif 'graceful_restart_disable' in bgp_session and bgp_session['graceful_restart_disable'] == 'true' %}
  neighbor {{ neighbor_addr }} graceful-restart-disable
{% elif 'graceful_restart_helper' in bgp_session and bgp_session['graceful_restart_helper'] == 'true' %}
  neighbor {{ neighbor_addr }} graceful-restart-helper
{% endif %}
