#!/bin/bash

depmod -a
systemctl stop syncd.service 2>/dev/null || true
systemctl stop swss.service 2>/dev/null || true
systemctl enable pddf-platform-init.service
systemctl start pddf-platform-init.service
systemctl enable rtc-sync.timer
systemctl start rtc-sync.timer
systemctl enable reboot-cause-rotate-log.timer
systemctl start reboot-cause-rotate-log.timer

